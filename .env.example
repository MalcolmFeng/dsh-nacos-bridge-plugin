# 必填：模型密钥（dsh 对话所用）
DEEPSEEK_API_KEY=

# Nacos 连接（默认值已内置，需要覆盖时再填）
# NACOS_SERVER_ADDR=http://127.0.0.1:8848
# NACOS_USERNAME=nacos
# NACOS_PASSWORD=nacos
# NACOS_NAMESPACE=public

# 注意：DSH_* 与 DEEPSEEK_BASE_URL 等 dsh 启动器保留变量不能放 .env，
# 放 .env.export（start.sh 会 source 并 export）。示例：
# .env.export:
#   DEEPSEEK_BASE_URL=http://your-gateway/v1
#   DSH_MODEL=deepseek-v4-flash
